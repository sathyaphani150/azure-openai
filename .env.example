# Runtime: azure or fake. Use fake only for offline development and automated tests.
AI_PROVIDER=azure

# Azure OpenAI (all values must come from your Azure resource/deployments)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=

# Optional DefaultAzureCredential selectors for Entra ID environments
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Knowledge base and retrieval
KNOWLEDGE_BASE_DIR=knowledge-base/pdf
VECTOR_STORE_DIR=data/vector-store
# Set true on a single-instance Azure App Service to build/rebuild a compatible index at startup.
KB_AUTO_INGEST=false
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
EMBEDDING_BATCH_SIZE=16

# Reliability and upload limits
AZURE_MAX_RETRIES=3
AZURE_REQUEST_TIMEOUT_SECONDS=45
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
LOG_LEVEL=INFO
